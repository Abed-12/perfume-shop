# Copy this file to .env and fill in your own values (never commit .env)

# Server port
PORT=

# LOCAL DATABASE CONNECTION (pgAdmin)
LOCAL_DB_URL=
LOCAL_DB_USERNAME=
LOCAL_DB_PASSWORD=

# PRODUCTION DATABASE CONNECTION
PROD_DB_URL=
PROD_DB_USERNAME=
PROD_DB_PASSWORD=

# JWT CONFIG (generate a secret, e.g. openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION_TIME=

# GMAIL CREDENTIALS (use a Gmail app password)
MAIL_USER=
MAIL_PASSWORD=

# ADMIN USER CREDENTIALS (used in DataInitializer seed)
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Copy this file to .env and fill in your own values (never commit .env)

# Server port
PORT=

# DATABASE CONNECTION (pgAdmin)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT CONFIG (generate a secret, e.g. openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION_TIME=

# GMAIL CREDENTIALS (use a Gmail app password)
MAIL_USER=
MAIL_PASSWORD=

# ADMIN USER CREDENTIALS (used in DataInitializer seed)
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# FIREBASE SERVICE ACCOUNT (classpath: or file: prefix)
FIREBASE_CREDENTIALS_PATH=

# FRONTEND BASE URL (no trailing slash) - used to build frontend URLs
FRONTEND_BASE_URL=

# CORS ALLOWED ORIGINS (comma separated, no trailing slash) - REQUIRED
CORS_ALLOWED_ORIGINS=
